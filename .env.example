# ── Supabase ────────────────────────────────────────────
# URL do projeto Supabase (disponivel em Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave publica anon (client-side). Protegida por RLS policies.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# Chave service_role (SERVER-SIDE APENAS - nunca expor no client).
# Usada nas rotas /api para login e alteracao de senha.
SUPABASE_SERVICE_KEY=sua-service-role-key

# ── Admin ───────────────────────────────────────────────
# Senha inicial do admin. No primeiro login o hash bcrypt e gravado
# em salon_settings (key='admin_senha_hash') e esta variavel deixa de ser usada.
ADMIN_SENHA=123456
